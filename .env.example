# Copy to `.env` — it is gitignored.

# Your Sleeper username. Used by `make sync-league` to discover your leagues.
# Sleeper's API is public and read-only; this is not a secret, just an identifier.
SLEEPER_USERNAME=

# Overrides for the defaults set in compose.yaml.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://postgres:postgres@db:5432/fantasy_football
